/* AWIN RPA - 模板管理和预览 TUI 样式 */

/* 主容器 - 使用垂直布局，留出 Header 和 Footer 空间 */
#main-container {
    width: 100%;
    height: 1fr;
    padding: 1;
    layout: vertical;
}

/* 区域标签 */
.section-label {
    color: $text-muted;
    margin-bottom: 1;
    text-style: bold;
}

/* 分隔线 */
.divider {
    height: 1;
    background: $surface-lighten-2;
    margin: 0;
}

/* 隐藏类 */
.hidden {
    display: none;
}

/* ===== 第一行：模板管理区域 - 占 80% ===== */

#template-section {
    height: 80%;
    margin-bottom: 0;
}

/* 左侧：模板列表 */
#template-list-wrapper {
    width: 36;
    height: 100%;
    margin-right: 2;
}

#template-list {
    height: 1fr;
    border: solid $primary;
    background: $surface;
}

#template-list > ListItem {
    padding: 0 1;
}

#template-list > ListItem:hover {
    background: $primary 20%;
}

#template-list > ListItem.-selected {
    background: $primary 40%;
}

#template-list-buttons {
    height: auto;
    margin-top: 1;
    width: 100%;
}

#template-list-buttons Button {
    width: 1fr;
    min-width: 8;
    margin-right: 0;
}

/* 中间：模板预览 */
#template-preview-wrapper {
    width: 1fr;
    height: 100%;
    margin-right: 2;
}

#template-preview {
    height: 1fr;
    border: solid $primary;
    background: $surface;
}

#template-preview:focus {
    border: solid $accent;
}

/* 右侧：按钮列 */
#template-action-column {
    width: 12;
    height: auto;
    padding-top: 2;
}

#template-action-column Button {
    width: 100%;
    margin-bottom: 1;
}

/* ===== 第二行：发送数量区域 - 占 10% ===== */

#send-count-section {
    height: 10%;
    min-height: 3;
    align: left middle;
    padding: 0 0;
    border-top: solid $surface-lighten-2;
}

#send-count-label {
    width: auto;
    margin-right: 2;
    color: $text;
}

#send-count-display {
    width: auto;
    min-width: 8;
    padding: 0 2;
    background: $surface;
    border: solid $primary;
    text-align: center;
}

#send-count-input {
    width: 12;
    margin-right: 0;
}

#send-count-unit {
    width: auto;
    margin-left: 1;
    margin-right: 2;
    color: $text-muted;
}

#count-action-column {
    width: 12;
    height: auto;
}

#count-action-column Button {
    width: 100%;
    margin-bottom: 0;
}

/* ===== 第三行：执行区域 - 默认占 10% ===== */

#execution-section {
    height: 10%;
    min-height: 5;
    border-top: solid $surface-lighten-2;
}

/* 执行中：执行区域占 60% */
#execution-section.running {
    height: 60%;
}

/* 执行中：模板区域缩小到 30% */
#template-section.running {
    height: 30%;
}

/* 执行中：发送数量区域缩小到 10% */
#send-count-section.running {
    height: 10%;
}

#execute-button-wrapper {
    width: auto;
    height: 100%;
    margin-right: 2;
    align: center middle;
}

.btn-connect {
    min-width: 14;
    margin-left: 1;
}

.btn-reset {
    min-width: 12;
    margin-left: 1;
}

.btn-large {
    min-width: 16;
    min-height: 3;
}

#log-wrapper {
    width: 1fr;
    height: 100%;
    border: solid $primary;
    background: $surface;
}

/* 右侧：退出按钮区域（占 10%） */
#quit-button-wrapper {
    width: 10%;
    min-width: 12;
    height: 100%;
    align: center middle;
    margin-left: 2;
}

.btn-quit {
    width: 100%;
}

#quit-hint {
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

#log-header {
    width: 100%;
    height: auto;
    padding: 0 1;
    text-align: center;
    text-style: bold;
    background: $surface-lighten-1;
    border-bottom: solid $primary;
}

#log-status {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $text-muted;
    background: $surface-darken-1;
    border-bottom: solid $surface-lighten-2;
}

#log-content {
    height: 1fr;
    padding: 1;
    background: $surface;
}

/* ===== 按钮变体覆盖 ===== */

Button.btn-large {
    min-width: 16;
    min-height: 3;
}
